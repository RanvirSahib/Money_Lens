# MoneyLens Backend Environment Configuration Example
# Copy this file to .env and fill in your credentials

# PostgreSQL / AWS RDS Configuration
DATABASE_URL=postgresql://moneylens:<YOUR_RDS_PASSWORD>@money-lens-db.cytc02yew2rk.us-east-1.rds.amazonaws.com:5432/postgres?sslmode=require
DB_SSLMODE=require

# AWS Bedrock Configuration
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=amazon.nova-micro-v1:0
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
